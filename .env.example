# ---------------------------------------------------------------------------
# TaskMaster API (server/) — copy to `.env` and fill in as needed.
# The server reads these from the real environment; `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Port the API listens on. The Vite dev server proxies /api here.
PORT=4000

# Secret used to sign session JWTs. Required in production (32+ chars).
# When unset, a development secret is generated into server/.jwt-secret.
JWT_SECRET=

# Session lifetime (jsonwebtoken syntax: 7d, 12h, 30m).
JWT_TTL=7d

# SQLite database file. Defaults to server/data.sqlite
DATABASE_FILE=

# Comma-separated list of browser origins allowed to call the API.
# Leave empty to allow any origin (convenient for local development).
CORS_ORIGIN=http://localhost:5173

# Set to 1 to silence per-request logging.
QUIET=0

# ---------------------------------------------------------------------------
# Supabase (identity)
# ---------------------------------------------------------------------------
# The browser signs in through Supabase Auth; these let the API verify the
# access tokens it receives. Values come from Project Settings → API.
# If unset, the API falls back to verifying only its own JWTs.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Client (Vite)
# ---------------------------------------------------------------------------

# Base URL of the API. Leave empty to use the dev proxy / same-origin requests.
VITE_API_URL=

# Supabase project — required for Sign Up, Sign In, Google and password reset.
# Supabase → Project Settings → API
#   Project URL        → VITE_SUPABASE_URL
#   anon / publishable key → VITE_SUPABASE_ANON_KEY
# Never commit real values: VITE_* keys ship inside the built bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
